{
  "id": "minishop-corp",
  "backend": {
    "entry_point": "minishop_corp:plugin"
  },
  "core_compatibility": {
    "mode": "capabilities",
    "requires": {
      "user_ui": 1,
      "ui_composition": 1
    }
  },
  "frontend": {
    "entry": "admin/index.js",
    "styles": [
      "admin/index.css"
    ],
    "sections": [
      {
        "id": "corporate-contracts",
        "view": "corporate-contracts",
        "group": "operations",
        "order": 100,
        "i18nKey": "admin_minishop_corp_title",
        "fallbackLabel": "Corporate subscriptions",
        "titleI18nKey": "admin_minishop_corp_title",
        "fallbackTitle": "Corporate subscriptions"
      }
    ],
    "user": {
      "entry": "customer/index.js",
      "styles": [
        "customer/index.css"
      ],
      "pages": [
        {
          "id": "corporate-home",
          "view": "corporate-home",
          "label": "Corporate subscription",
          "i18nKey": "wa_minishop_corp_title",
          "icon": "shield",
          "order": 100,
          "parent": "settings",
          "navigation": "hidden"
        },
        {
          "id": "corporate-manager",
          "view": "corporate-manager",
          "label": "Subscription management",
          "i18nKey": "wa_minishop_corp_manager_title",
          "icon": "shield",
          "order": 110,
          "parent": "settings",
          "navigation": "hidden"
        }
      ],
      "slots": [
        {
          "id": "corporate-card",
          "view": "corporate-card",
          "label": "Corporate subscription",
          "i18nKey": "wa_minishop_corp_title",
          "target": "user.settings.cards",
          "order": 100
        }
      ]
    }
  }
}
